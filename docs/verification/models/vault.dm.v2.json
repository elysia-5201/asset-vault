      "kind": "no-orphan"
    },
    {
      "id": "asset-avatars-no-orphan",
      "description": "资产-模型关联无孤儿",
      "entity": "asset_avatars",
      "field": "asset_id",
      "refEntity": "assets",
      "kind": "no-orphan"
    },
    {
      "id": "aliases-no-orphan",
      "description": "别名必须挂在模型上",
      "entity": "avatar_aliases",
      "field": "avatar_id",
      "refEntity": "avatars",
      "kind": "no-orphan"
    },
    {
      "id": "cover-image-exists",
      "description": "封面图必须是已存在的图片行",
      "entity": "items",
      "field": "cover_image_id",
      "refEntity": "item_images",
      "refField": "id",
      "kind": "referential-integrity"
    },
    {
      "id": "avatar-name-required",
