  "invariants": [
    {
      "id": "item-avatar-unique",
      "description": "同一条目同一 avatar 只有一条关联",
      "entity": "item_avatars",
      "fields": [
        "item_id",
        "avatar_id"
      ],
      "kind": "unique"
    },
    {
      "id": "asset-avatar-unique",
      "description": "同一资产同一 avatar 同一内部前缀只有一条关联",
      "entity": "asset_avatars",
      "fields": [
        "asset_id",
        "avatar_id",
        "entry_prefix"
      ],
      "kind": "unique"
    },
