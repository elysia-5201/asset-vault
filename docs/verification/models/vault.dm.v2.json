      "entity": "avatars",
      "field": "name",
      "kind": "field-required"
    },
    {
      "id": "alias-required",
      "description": "别名必填",
      "entity": "avatar_aliases",
      "field": "alias",
      "kind": "field-required"
    },
    {
      "id": "title-required",
      "description": "标题必填",
      "entity": "items",
      "field": "title",
      "kind": "field-required"
    },
    {
      "id": "confidence-range",
      "description": "关联置信度 0..1",
      "entity": "item_avatars",
      "field": "confidence",
      "min": 0,
      "max": 1,
      "kind": "range"
    },
    {
      "id": "declared-count-range",
