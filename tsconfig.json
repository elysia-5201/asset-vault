{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@core/*": [
        "packages/core/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "packages/core/src",
    "apps/server/src",
    "apps/web/src",
    "test",
    "scripts"
  ]
}
